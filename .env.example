# --- AI (legacy until Phase 6 Hugging Face migration) ---
GEMINI_API_KEY=

# --- Supabase (Phase 3+) ---
# Create a free project at https://supabase.com
# GitHub Actions: add SUPABASE_URL, SUPABASE_SERVICE_KEY, SUPABASE_ANON_KEY as repo secrets
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Pipeline: use JSON file instead of Supabase (local fallback)
USE_JSON_STORE=false

# --- Dashboard (Vite) ---
VITE_USE_BACKEND=false
VITE_USE_SUPABASE=false
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_BASE_PATH=/
