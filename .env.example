# --- AI (Phase 6 local embeddings + optional Gemini fallback) ---
# Optional: only used when embedding scorer fails or AI_SCORER=gemini
GEMINI_API_KEY=
# Hugging Face model cache directory (GitHub Actions caches ~/.cache/huggingface)
HF_HOME=~/.cache/huggingface
AI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_SCORER=embedding

# --- Supabase (Phase 3+) ---
# Create a free project at https://supabase.com
# GitHub Actions: add SUPABASE_URL, SUPABASE_SERVICE_KEY, SUPABASE_ANON_KEY as repo secrets
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Pipeline: use JSON file instead of Supabase (local fallback)
USE_JSON_STORE=false

# --- Scanners (Phase 4) — comma-separated lists ---
# Public Greenhouse board tokens (from boards.greenhouse.io URL)
GREENHOUSE_BOARD_TOKENS=
# Legacy single token (optional)
GREENHOUSE_BOARD_TOKEN=

# Lever company site slugs (jobs.lever.co/{site})
LEVER_COMPANY_SITES=

# SmartRecruiters company identifiers
SMARTRECRUITERS_COMPANIES=

# Teamtailor subdomain slugs ({slug}.teamtailor.com)
TEAMTAILOR_COMPANY_SLUGS=

# Workable account slugs (apply.workable.com/{account})
WORKABLE_ACCOUNT_SLUGS=

# RemoteOK and We Work Remotely need no configuration.

# Scanner match policy (overrides defaults in packages/database/python/constants.py)
SCANNER_MIN_MATCH_SCORE=90
SCANNER_MIN_JOBS_PER_RUN=3
# Aggressive discovery: scan until sources exhausted (0 = unlimited passes)
SCANNER_MAX_PASSES=0
SCANNER_LIMIT_STEP=50
SCANNER_MAX_LIMIT_PER_SOURCE=2000
SCANNER_MAX_EVALUATIONS=3000

# --- Dashboard (Vite) ---
VITE_USE_BACKEND=false
VITE_USE_SUPABASE=false
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_BASE_PATH=/
