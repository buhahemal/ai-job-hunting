# --- AI (Phase 6 local embeddings — Hugging Face on GitHub Actions runner) ---
# Hugging Face model cache directory (GitHub Actions caches ~/.cache/huggingface)
HF_HOME=~/.cache/huggingface
AI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_SCORER=embedding
# Cosine similarity threshold for embedding duplicate detection (0.0–1.0)
AI_DUPLICATE_THRESHOLD=0.92

# --- Supabase (Phase 3+) ---
# Create a free project at https://supabase.com
# GitHub Actions: add SUPABASE_URL, SUPABASE_SERVICE_KEY, SUPABASE_ANON_KEY as repo secrets
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# --- Scanners (Phase 4) — comma-separated lists ---
# Public Greenhouse board tokens (from boards.greenhouse.io URL)
GREENHOUSE_BOARD_TOKENS=gitlab,stripe,cloudflare,hashicorp

# Lever company site slugs (jobs.lever.co/{site})
LEVER_COMPANY_SITES=spotify,netflix,figma,palantir

# SmartRecruiters company identifiers
SMARTRECRUITERS_COMPANIES=Square,Visa

# Teamtailor subdomain slugs ({slug}.teamtailor.com)
TEAMTAILOR_COMPANY_SLUGS=spotify,klarna

# Workable account slugs (apply.workable.com/{account})
WORKABLE_ACCOUNT_SLUGS=workable,samsara

# Ashby job board slugs (jobs.ashbyhq.com/{slug})
ASHBY_JOB_BOARD_SLUGS=linear,notion,vercel,supabase,replit

# Workday career sites: tenant:wd5:SiteName or full career URL
WORKDAY_CAREER_SITES=https://nvidia.wd5.myworkdayjobs.com/NVIDIAExternalCareerSite

# Wellfound search paths (optional — server fetch often blocked)
WELLFOUND_SEARCH_PATHS=/role/l/software-engineer/remote

# RemoteOK, We Work Remotely, and Arbeitnow need no configuration.

# Scanner match policy (overrides defaults in packages/database/python/constants.py)
SCANNER_MIN_MATCH_SCORE=75
SCANNER_MIN_JOBS_PER_RUN=25
# Discovery bounds (0 max passes = unlimited; CI uses 4)
SCANNER_MAX_PASSES=4
SCANNER_LIMIT_STEP=50
SCANNER_MAX_LIMIT_PER_SOURCE=200
SCANNER_MAX_EVALUATIONS=500
ATS_DISCOVERY_ENABLED=true

# --- Dashboard (Vite) ---
VITE_USE_BACKEND=false
VITE_USE_SUPABASE=false
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_BASE_PATH=/
