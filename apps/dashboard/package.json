{
  "name": "@ai-job-hunter/dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "mkdir -p public/data && cp ../api/data/HemalBuha-Resume.pdf public/data/HemalBuha-Resume.pdf",
    "dev": "vite",
    "prebuild": "mkdir -p public/data && cp ../api/data/HemalBuha-Resume.pdf public/data/HemalBuha-Resume.pdf",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --config ../../eslint.config.mjs --max-warnings 0",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-job-hunter/database": "*",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  }
}
