{
  "name": "ai-job-hunting",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/dashboard",
    "packages/config",
    "packages/database"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ai-job-hunter/dashboard",
    "dev:api": "PYTHONPATH=. python3 apps/api/server.py",
    "dev:full": "VITE_USE_BACKEND=true npm run dev --workspace=@ai-job-hunter/dashboard",
    "build": "npm run build --workspace=@ai-job-hunter/dashboard",
    "typecheck": "npm run typecheck --workspace=@ai-job-hunter/dashboard",
    "lint": "eslint apps/dashboard/src packages/database/src packages/config/src --max-warnings 0",
    "lint:python": "bash -c 'if [ -x .venv/bin/ruff ]; then .venv/bin/ruff check apps packages scraper scanners scripts; else ruff check apps packages scraper scanners scripts; fi'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace=@ai-job-hunter/dashboard && PYTHONPATH=. python3 -m unittest discover -s scraper/tests && PYTHONPATH=. python3 -m unittest discover -s packages/database/tests && PYTHONPATH=. python3 -m unittest discover -s packages/scanner_sdk/tests && PYTHONPATH=. python3 -m unittest discover -s packages/ai_engine/tests",
    "test:coverage": "npm run test:coverage --workspace=@ai-job-hunter/dashboard",
    "scan": "PYTHONPATH=. python3 -m scraper",
    "scanner:health": "PYTHONPATH=. python3 scripts/scanner_health.py",
    "sync:profile": "PYTHONPATH=. python3 scripts/sync_profile_to_supabase.py",
    "quality:duplicates": "jscpd --config .jscpd.json",
    "quality:dead-code": "knip",
    "arch:depcruise": "depcruise apps/dashboard/src packages --config .dependency-cruiser.cjs --output-type err",
    "arch:madge": "madge --circular --extensions ts,tsx apps/dashboard/src packages",
    "spellcheck": "cspell --no-progress \"**/*.{md,ts,tsx}\" \"**/*.py\"",
    "quality": "npm run typecheck && npm run lint && npm run lint:python && npm run quality:duplicates && npm run quality:dead-code && npm run arch:madge && npm run arch:depcruise && npm run spellcheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.1",
    "cspell": "^9.2.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "husky": "^9.1.7",
    "jscpd": "^3.5.10",
    "knip": "^5.62.0",
    "lint-staged": "^15.5.2",
    "madge": "^8.0.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.48.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,yml,yaml}": "prettier --write"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.2",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
